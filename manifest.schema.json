{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "properties": {
        "questionSets": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string",
                        "description": "The name of the question set"
                    },
                    "description": {
                        "type": "string",
                        "description": "Optional description of the question set"
                    },
                    "url": {
                        "type": "string",
                        "description": "URL relative to web root of the json file containing the questions"
                    }
                },
                "description": "Question set config",
                "required": [
                    "name",
                    "url"
                ]
            }
        },
        "name": {
            "type": "string",
            "description": "The name of the survey"
        },
        "description": {
            "type": "string",
            "description": "Any description to display to the user"
        }
    },
    "required": [
        "name",
        "questionSets"
    ]
}
